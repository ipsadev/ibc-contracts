pragma solidity ^0.8.28;

// solhint-disable custom-errors,gas-custom-errors,gas-small-strings

import { Test } from "forge-std/Test.sol";
import { SP1Verifier as SP1VerifierGroth16 } from "@sp1-contracts/v6.1.0/SP1VerifierGroth16.sol";

import { SP1ICSStellar } from "../../contracts/light-clients/sp1-stellar/SP1ICSStellar.sol";
import { ISP1ICSStellarErrors } from "../../contracts/light-clients/sp1-stellar/errors/ISP1ICSStellarErrors.sol";
import { IICSStellarMsgs } from "../../contracts/light-clients/sp1-stellar/msgs/IICSStellarMsgs.sol";
import { IStellarUpdateClientMsgs } from "../../contracts/light-clients/sp1-stellar/msgs/IStellarUpdateClientMsgs.sol";
import { ISP1Msgs } from "../../contracts/light-clients/sp1-ics07/msgs/ISP1Msgs.sol";
import { ILightClientMsgs } from "../../contracts/msgs/ILightClientMsgs.sol";

/// @title Real proof tests
/// @notice Verifies a real Groth16 proof of a real Stellar mainnet ledger, on-chain.
/// @dev Every other test in this directory uses SP1MockVerifier, which accepts any proof and so
/// tests the contract's own logic but nothing about the proof. This one deploys the same
/// SP1VerifierGroth16 that would be deployed on a real chain and puts a proof of mainnet ledger
/// 63,907,880 through it. It is the only test here that would fail if the circuit, its verifying
/// key and the Solidity ABI had drifted apart.
///
/// The fixture is generated by:
/// `SP1_PROOF_MODE=groth16 SP1_PROOF_EXPORT=... cargo run -p sp1-stellar-prover --bin prove`
/// which needs a Docker daemon. It is committed because the proof is a static artifact: nothing
/// here regenerates it, and it stops verifying if the verifying key moves, which is the point.
contract SP1ICSStellarProofTest is Test {
    string public constant FIXTURE = "test/sp1-stellar/fixtures/groth16.json";

    SP1VerifierGroth16 public verifier;
    SP1ICSStellar public client;

    bytes32 public vkey;
    bytes public publicValues;
    bytes public proof;

    IStellarUpdateClientMsgs.UpdateClientOutput internal output;

    function setUp() public {
        string memory json = vm.readFile(FIXTURE);

        vkey = vm.parseJsonBytes32(json, ".vkey");
        publicValues = vm.parseJsonBytes(json, ".publicValues");
        proof = vm.parseJsonBytes(json, ".proof");

        output = abi.decode(publicValues, (IStellarUpdateClientMsgs.UpdateClientOutput));

        verifier = new SP1VerifierGroth16();

        client = new SP1ICSStellar(
            vkey,
            bytes32(uint256(0x2222)),
            bytes32(uint256(0x3333)),
            address(verifier),
            abi.encode(output.clientState),
            keccak256(abi.encode(output.trustedConsensusState)),
            address(0)
        );
    }

    function _message(bytes memory proofBytes) internal view returns (bytes memory) {
        return abi.encode(IStellarUpdateClientMsgs.MsgUpdateClient(ISP1Msgs.SP1Proof(vkey, publicValues, proofBytes)));
    }

    /// @dev The whole chain in one call: a real Groth16 proof, verified by the real SP1 verifier,
    /// committing public values the contract decodes into the ledger Stellar actually closed.
    function test_ARealProofOfARealLedgerVerifiesOnChain() public {
        ILightClientMsgs.UpdateResult result = client.updateClient(_message(proof));

        assertEq(uint8(result), uint8(ILightClientMsgs.UpdateResult.Update), "a real proof is an update");

        assertEq(
            client.getConsensusStateHash(output.newHeight.revisionHeight),
            keccak256(abi.encode(output.newConsensusState)),
            "the verified consensus state is stored"
        );

        IICSStellarMsgs.ClientState memory state = abi.decode(client.getClientState(), (IICSStellarMsgs.ClientState));

        assertEq(state.latestHeight.revisionHeight, output.newHeight.revisionHeight, "the client advanced");
    }

    /// @dev The values the circuit committed have to be the ledger Stellar published. These are the
    /// same values `verify-against-horizon.py` checks the fixture against, so a circuit that
    /// committed something else would fail here rather than at a chain boundary.
    function test_TheProvenLedgerIsTheOneStellarPublished() public view {
        assertEq(output.newHeight.revisionHeight, 63_907_880, "mainnet ledger 63907880");

        assertEq(
            output.newConsensusState.ledgerHash,
            bytes32(0x57f1147d7b800c956df0ed72425bf0fa474ddc22cff06ba901dbc76e82f29fd6),
            "the ledger hash Horizon publishes"
        );

        assertEq(
            output.newConsensusState.bucketListHash,
            bytes32(0x43a27551bf8875e83d8e27073a57ff2fbe32e8f22f1865ac1314f3d616e4348c),
            "the bucket list hash Horizon's header decodes to"
        );

        assertEq(
            output.clientState.trustRootFingerprint,
            bytes32(0x958e72b84e731d94ad1487953db489add23b67df1b1afab4d02bbadab0519294),
            "the pinned trust root"
        );
    }

    /// @dev A proof is bound to its public values. Flipping one byte of the committed output must
    /// make the verifier reject it, or the public values would be a suggestion rather than a claim.
    function test_TamperedPublicValuesAreRejectedByTheVerifier() public {
        publicValues[publicValues.length - 1] ^= 0x01;

        vm.expectRevert();
        client.updateClient(_message(proof));
    }

    /// @dev The same, from the other side: the proof bytes themselves cannot be altered.
    function test_ATamperedProofIsRejectedByTheVerifier() public {
        bytes memory tampered = proof;
        tampered[tampered.length - 1] ^= 0x01;

        vm.expectRevert();
        client.updateClient(_message(tampered));
    }

    /// @dev Everything upstream of the verifier is checked first, so a proof that is genuine but
    /// was made for a different program is refused before it is ever verified.
    function test_ARealProofUnderTheWrongVerifyingKeyIsRefused() public {
        bytes memory message =
            abi.encode(IStellarUpdateClientMsgs.MsgUpdateClient(ISP1Msgs.SP1Proof(bytes32(0), publicValues, proof)));

        vm.expectRevert(abi.encodeWithSelector(ISP1ICSStellarErrors.VerificationKeyMismatch.selector, vkey, bytes32(0)));
        client.updateClient(message);
    }

    /// @dev The fixture's verifying key must be the one pinned for the update-client program. If it
    /// is not, this suite is verifying a proof of something other than what ships.
    function test_TheProofWasMadeByThePinnedProgram() public view {
        string memory pinned = vm.readFile("programs/sp1-stellar-programs/vkeys.json");

        assertEq(vkey, vm.parseJsonBytes32(pinned, ".update-client"), "the proof is of the pinned program");
    }
}
